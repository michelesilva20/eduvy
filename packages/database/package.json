{
  "name": "@eduvy/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "db:generate": "node ../../node_modules/prisma/build/index.js generate --schema=prisma/schema.prisma",
    "db:migrate": "node ../../node_modules/prisma/build/index.js migrate deploy --schema=prisma/schema.prisma",
    "db:migrate:dev": "node ../../node_modules/prisma/build/index.js migrate dev --schema=prisma/schema.prisma",
    "db:push": "node ../../node_modules/prisma/build/index.js db push --schema=prisma/schema.prisma",
    "db:seed": "node ../../node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "db:studio": "node ../../node_modules/prisma/build/index.js studio --schema=prisma/schema.prisma",
    "sql:rls": "node scripts/apply-sql.mjs sql/rls",
    "sql:roles": "node scripts/apply-sql.mjs sql/roles",
    "sql:post-migrate": "pnpm sql:roles && pnpm sql:rls",
    "verify:rls": "node ../../node_modules/tsx/dist/cli.mjs scripts/verify-rls.ts",
    "test:integration": "pnpm -w exec jest --config packages/database/jest.integration.config.js"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0"
  },
  "devDependencies": {
    "@eduvy/tsconfig": "workspace:*",
    "@jest/globals": "^29.7.0",
    "@types/pg": "^8.11.11",
    "argon2": "^0.41.1",
    "pg": "^8.14.1",
    "prisma": "^6.5.0",
    "tsx": "^4.19.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "typescript": "^5.8.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
