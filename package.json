{
  "name": "@eduvy/web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "next dev",
    "dev:api": "pnpm --filter @eduvy/api dev",
    "dev:worker": "pnpm --filter @eduvy/worker dev",
    "build": "next build",
    "build:api": "pnpm --filter @eduvy/api build",
    "build:worker": "pnpm --filter @eduvy/worker build",
    "build:packages": "pnpm exec tsc -p packages/config/tsconfig.json && pnpm exec tsc -p packages/contracts/tsconfig.json && pnpm exec tsc -p packages/database/tsconfig.json && pnpm exec tsc -p packages/logger/tsconfig.json",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "pnpm -r typecheck && pnpm typecheck",
    "test:unit": "pnpm --filter @eduvy/api exec node ../../node_modules/jest/bin/jest.js --config jest.config.js",
    "test:integration": "pnpm --filter @eduvy/database test:integration",
    "ci:db-prepare": "pnpm db:generate && pnpm --filter @eduvy/database db:migrate && pnpm --filter @eduvy/database sql:post-migrate",
    "smoke:assessment-engine": "node --env-file=.env scripts/smoke-assessment-engine-api.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "db:generate": "pnpm exec prisma generate --schema=packages/database/prisma/schema.prisma",
    "db:migrate": "pnpm --filter @eduvy/database db:migrate:dev",
    "db:deploy": "pnpm --filter @eduvy/database db:migrate && pnpm --filter @eduvy/database sql:post-migrate",
    "db:seed": "pnpm --filter @eduvy/database db:seed",
    "db:verify-rls": "pnpm --filter @eduvy/database verify:rls"
  },
  "dependencies": {
    "@eduvy/config": "workspace:*",
    "@eduvy/contracts": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "jose": "^6.0.10",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
