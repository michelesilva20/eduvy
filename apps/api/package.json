{
  "name": "@eduvy/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node ../../node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "dev": "pnpm exec tsx watch --tsconfig tsconfig.build.json --env-file=../../.env src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "node ../../node_modules/typescript/bin/tsc -p tsconfig.build.json --noEmit",
    "test": "node ../../node_modules/jest/bin/jest.js --config jest.config.js",
    "test:integration": "node ../../node_modules/jest/bin/jest.js --config jest.integration.config.ts"
  },
  "dependencies": {
    "@eduvy/config": "workspace:*",
    "@eduvy/contracts": "workspace:*",
    "@eduvy/database": "workspace:*",
    "@eduvy/logger": "workspace:*",
    "@nestjs/common": "^11.0.12",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/swagger": "^11.1.0",
    "@nestjs/throttler": "^6.4.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "jose": "^6.0.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@eduvy/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.6",
    "@nestjs/schematics": "^11.0.3",
    "@nestjs/testing": "^11.0.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.24",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
